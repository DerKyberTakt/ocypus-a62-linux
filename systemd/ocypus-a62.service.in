[Unit]
Description=Ocypus IOTA A62 cooler display - CPU temperature
Documentation=https://github.com/DerKyberTakt/ocypus-a62-linux
# Nothing to wait for: the daemon polls for the device itself.

[Service]
Type=simple
ExecStart=@BINDIR@/ocypus-a62 run
Restart=always
RestartSec=5
Nice=10

# Hardening. The daemon only needs read access to /sys/class/hwmon and
# /sys/class/hidraw, read access to its config, and write access to the
# one /dev/hidraw node the udev rule exposes.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=default.target
